---
import Layout from '@/layouts/Layout.astro'
import { PKB_MODULE_TITLES } from '@pkba/domain'
---

<Layout meta={{ type: 'page', title: 'PKB Academy - Penguji Kendaraan Bermotor', description: 'Latihan bertingkat untuk persiapan Diklat PKB Dasar, 12 modul lengkap dengan penilaian otomatis' }}>
        <div class="flex flex-col gap-8">
                <section>
                        <h1 class="text-h1 text-P-heading mb-2">PKB Academy</h1>
                        <p class="text-P-lead">Penguji Kendaraan Bermotor (PKB) Dasar)</p>
                        <p class="text-P-subtle mt-2">Platform pembelajaran bertahap untuk persiapan Diklat PKB Dasar dengan penilaian otomatis.</p>
                </section>

                <div class="grid md:grid-cols-2 gap-6">
                        <section class="rounded-lg border bg-P-card p-6 shadow-sm">
                                <h2 class="text-h3 text-P-heading mb-4">Evaluasi Kompetensi</h2>
                                <div class="space-y-3">
                                        <div class="flex justify-between items-center py-2 border-b border-P-border">
                                                <span class="text-P-fg">Kuis (5 soal)</span>
                                                <span class="font-medium text-P-link">Skor minimal: 70%</span>
                                        </div>
                                        <div class="flex justify-between items-center py-2 border-b border-P-border">
                                                <span class="text-P-fg">Latihan (10 skenario)</span>
                                                <span class="font-medium text-P-link">Skor minimal: 70%</span>
                                        </div>
                                        <div class="flex justify-between items-center py-2 border-b border-P-border">
                                                <span class="text-P-fg">Final: Bagian A (35 soal)</span>
                                                <span class="font-medium text-P-link">≥ 70% skor minimum</span>
                                        </div>
                                        <div class="flex justify-between items-center py-2 border-b border-P-border">
                                                <span class="text-P-fg">Final: Bagian B (6 soal)</span>
                                                <span class="font-medium text-P-link">≥ 70% skor minimum</span>
                                        </div>
                                </div>
                        </section>

                        <section class="rounded-lg border bg-P-card p-6 shadow-sm">
                                <h2 class="text-h3 text-P-heading mb-4">Modul Pembelajaran (12)</h2>
                                <div class="space-y-2">
                                        {PKB_MODULE_TITLES.map((title, index) => (
                                                <div class="flex items-center gap-3">
                                                        <div class="w-6 h-6 rounded-full bg-P-muted text-P-subtle flex items-center justify-center text-xs">{index + 1}</div>
                                                        <span class="text-sm text-P-fg">{title}</span>
                                                </div>
                                        ))}
                                </div>
                        </section>
                </div>

                <section class="rounded-lg border bg-P-card p-6 shadow-sm">
                        <h2 class="text-h3 text-P-heading mb-4">Aturan Penting</h2>
                        <div class="grid md:grid-cols-3 gap-4">
                                <div class="flex gap-3">
                                        <div class="w-10 h-10 rounded-full bg-green-100 text-green-600 flex items-center justify-center flex-shrink-0">✅</div>
                                        <div>
                                                <h3 class="font-semibold text-P-heading">Kuis</h3>
                                                <p class="text-sm text-P-fg">≤ 2 attempts allowed</p>
                                                <p class="text-xs text-P-subtle">Minimal skor 70%</p>
                                        </div>
                                </div>
                                <div class="flex gap-3">
                                        <div class="w-10 h-10 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center flex-shrink-0">⏰</div>
                                        <div>
                                                <h3 class="font-semibold text-P-heading">Latihan</h3>
                                                <p class="text-sm text-P-fg">≤ 3 attempts allowed</p>
                                                <p class="text-xs text-P-subtle">Minimal skor 70%</p>
                                        </div>
                                </div>
                                <div class="flex gap-3">
                                        <div class="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center flex-shrink-0">🔄</div>
                                        <div>
                                                <h3 class="font-semibold text-P-heading">Final</h3>
                                                <p class="text-sm text-P-fg">≤ 2 attempts/24 jam</p>
                                                <p class="text-xs text-P-subtle">Skor target: 70%</p>
                                        </div>
                                </div>
                        </div>
                </section>

                <section class="rounded-lg border bg-P-card p-6 shadow-sm">
                        <h2 class="text-h3 text-P-heading mb-4">Tips Sukses</h2>
                        <div class="grid md:grid-cols-2 gap-4">
                                <div class="flex gap-3">
                                        <div class="w-8 h-8 rounded-full bg-P-muted text-P-subtle flex items-center justify-center flex-shrink-0">📊</div>
                                        <div>
                                                <h3 class="font-semibold text-P-heading">Target Skor</h3>
                                                <p class="text-sm text-P-fg">Usahakan skor ≥70% di setiap modul sebelum melanjutkan</p>
                                        </div>
                                </div>
                                <div class="flex gap-3">
                                        <div class="w-8 h-8 rounded-full bg-P-muted text-P-subtle flex items-center justify-center flex-shrink-0">⏰</div>
                                        <div>
                                                <h3 class="font-semibold text-P-heading">Jadwal</h3>
                                                <p class="text-sm text-P-fg">Bagian-A + Bagian-B dengan interval 24 jam antara attempts</p>
                                        </div>
                                </div>
                                <div class="flex gap-3">
                                        <div class="w-8 h-8 rounded-full bg-P-muted text-P-subtle flex items-center justify-center flex-shrink-0">📝</div>
                                        <div>
                                                <h3 class="font-semibold text-P-heading">Progress</h3>
                                                <p class="text-sm text-P-fg">Setiap modul memiliki bobot berbeda (Pembelajaran 70%, Kuis 20%, Latihan 10%)</p>
                                        </div>
                                </div>
                                <div class="flex gap-3">
                                        <div class="w-8 h-8 rounded-full bg-P-muted text-P-subtle flex items-center justify-center flex-shrink-0">🎯</div>
                                        <div>
                                                <h3 class="font-semibold text-P-heading">Strategi</h3>
                                                <p class="text-sm text-P-fg">Fokus pada quality over quantity - satu soal per sesi</p>
                                        </div>
                                </div>
                        </div>
                </section>
        </div>
</Layout>