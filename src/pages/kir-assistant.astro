---
import Layout from '@/layouts/Layout.astro'

const title = 'Asisten Regulasi KIR'
---

<Layout
  meta={{
    type: 'page',
    title,
    description: 'Asisten AI untuk menjawab pertanyaan seputar regulasi pengujian berkala kendaraan bermotor.',
  }}
  variant="full"
>
  <div id="kir-chat" class="flex flex-col h-[calc(100dvh-var(--layout-header-height)-var(--layout-footer-height))]">

    <!-- Header chat -->
    <div class="flex items-center gap-3 px-4 py-3 border-b border-P-border bg-P-bg shrink-0">
      <div class="flex items-center justify-center w-8 h-8 rounded-md border border-P-border bg-P-muted text-P-subtle shrink-0">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="4" y="4" width="16" height="16" rx="2"/>
          <path d="M8 10h8M8 14h5"/>
        </svg>
      </div>
      <div>
        <div class="text-sm font-semibold text-P-heading">Asisten Regulasi KIR</div>
        <div class="text-xs text-P-subtle">UPUBKB · Dinas Perhubungan Kab. Lumajang</div>
      </div>
      <div class="ml-auto flex items-center gap-1.5 text-xs text-P-subtle">
        <span id="status-dot" class="inline-block w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
        <span id="status-text">Online</span>
      </div>
    </div>

    <!-- Messages -->
    <div id="messages" class="flex-1 overflow-y-auto px-4 py-4 space-y-4">
      <!-- Welcome message -->
      <div class="flex gap-2 msg-assistant">
        <div class="flex items-center justify-center w-7 h-7 rounded shrink-0 mt-0.5 border border-P-border bg-P-muted text-P-subtle">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
        </div>
        <div class="flex flex-col gap-1 max-w-[80%]">
          <div class="rounded-lg px-3 py-2 text-sm bg-P-muted text-P-fg border border-P-border">
            Selamat datang. Saya dapat membantu menjawab pertanyaan seputar peraturan pengujian berkala kendaraan bermotor. Silakan ajukan pertanyaan Anda.
          </div>
        </div>
      </div>

      <!-- Suggestions -->
      <div id="suggestions" class="flex flex-wrap gap-2 pl-9">
        {[
          'Apa saja dokumen yang diperlukan untuk uji berkala?',
          'Berapa masa berlaku tanda uji kendaraan?',
          'Apa sanksi jika kendaraan tidak melakukan uji berkala?',
          'Kendaraan apa saja yang wajib uji berkala?',
        ].map(s => (
          <button
            class="suggestion-chip text-xs px-3 py-1.5 rounded border border-P-border bg-P-bg text-P-subtle hover:border-P-link hover:text-P-link hover:bg-P-muted transition-colors"
            data-text={s}
          >
            {s}
          </button>
        ))}
      </div>
    </div>

    <!-- Input area -->
    <div class="border-t border-P-border bg-P-bg px-4 py-3 shrink-0">
      <div id="input-row" class="flex items-end gap-2 rounded-lg border border-P-border bg-P-muted px-3 py-2 focus-within:border-P-link transition-colors">
        <textarea
          id="chat-input"
          rows="1"
          placeholder="Tanyakan tentang peraturan uji berkala..."
          class="flex-1 bg-transparent outline-none resize-none text-sm text-P-fg placeholder:text-P-subtle min-h-[22px] max-h-[120px] overflow-y-auto"
        ></textarea>
        <button
          id="send-btn"
          class="flex items-center justify-center w-8 h-8 rounded-md bg-P-link text-white shrink-0 hover:opacity-90 disabled:opacity-40 disabled:cursor-not-allowed transition-opacity"
          disabled
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
          </svg>
        </button>
      </div>
      <p class="text-xs text-P-subtle mt-1.5 text-right">Enter untuk kirim · Shift+Enter baris baru</p>
    </div>

  </div>
</Layout>

<script>
  const WORKER_URL = 'https://chatbot-regulasi.prnmjpngst.workers.dev'

  // State
  const history: { role: 'user' | 'assistant'; content: string }[] = []

  // DOM refs
  const messagesEl = document.getElementById('messages')!
  const inputEl = document.getElementById('chat-input') as HTMLTextAreaElement
  const sendBtn = document.getElementById('send-btn') as HTMLButtonElement
  const suggestionsEl = document.getElementById('suggestions')!

  // Auto-resize textarea
  inputEl.addEventListener('input', () => {
    inputEl.style.height = 'auto'
    inputEl.style.height = Math.min(inputEl.scrollHeight, 120) + 'px'
    sendBtn.disabled = !inputEl.value.trim()
  })

  // Suggestion chips
  document.querySelectorAll('.suggestion-chip').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = (btn as HTMLElement).dataset.text || ''
      sendMessage(text)
    })
  })

  // Send on Enter
  inputEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault()
      if (!sendBtn.disabled) sendMessage()
    }
  })

  sendBtn.addEventListener('click', () => sendMessage())

  function scrollToBottom() {
    messagesEl.scrollTop = messagesEl.scrollHeight
  }

  function appendUserMessage(text: string) {
    suggestionsEl.remove()

    const div = document.createElement('div')
    div.className = 'flex justify-end msg-user'
    div.innerHTML = `
      <div class="max-w-[80%]">
        <div class="rounded-lg px-3 py-2 text-sm bg-P-link/10 text-P-fg border border-P-link/20">
          ${escapeHtml(text)}
        </div>
      </div>
    `
    messagesEl.appendChild(div)
    scrollToBottom()
  }

  function appendAssistantMessage(): HTMLElement {
    const div = document.createElement('div')
    div.className = 'flex gap-2 msg-assistant'
    div.innerHTML = `
      <div class="flex items-center justify-center w-7 h-7 rounded shrink-0 mt-0.5 border border-P-border bg-P-muted text-P-subtle">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
      </div>
      <div class="flex flex-col gap-1 max-w-[80%]">
        <div class="bubble rounded-lg px-3 py-2 text-sm bg-P-muted text-P-fg border border-P-border">
          <span class="typing">
            <span class="dot">·</span><span class="dot">·</span><span class="dot">·</span>
          </span>
        </div>
        <div class="sources hidden flex flex-wrap gap-1 items-center"></div>
      </div>
    `
    messagesEl.appendChild(div)
    scrollToBottom()
    return div
  }

  function fillAssistantMessage(
    el: HTMLElement,
    text: string,
    sources: string[],
    hasContext: boolean
  ) {
    const bubble = el.querySelector('.bubble')!
    bubble.innerHTML = escapeHtml(text).replace(/\n/g, '<br>')

    if (!hasContext) {
      const warn = document.createElement('p')
      warn.className = 'mt-1.5 text-xs text-amber-500'
      warn.textContent = '⚠ Tidak ada regulasi relevan ditemukan dalam basis data'
      bubble.appendChild(warn)
    }

    if (sources.length > 0) {
      const sourcesEl = el.querySelector('.sources')!
      sourcesEl.classList.remove('hidden')
      sourcesEl.innerHTML = `
        <span class="text-xs text-P-subtle">Sumber:</span>
        ${sources.map(s => `<span class="text-xs px-2 py-0.5 rounded border border-P-border bg-P-muted text-P-subtle">${escapeHtml(s)}</span>`).join('')}
      `
    }

    scrollToBottom()
  }

  function setLoading(loading: boolean) {
    sendBtn.disabled = loading
    inputEl.disabled = loading
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
  }

  async function sendMessage(text?: string) {
    const msg = (text ?? inputEl.value).trim()
    if (!msg) return

    inputEl.value = ''
    inputEl.style.height = 'auto'
    sendBtn.disabled = true

    appendUserMessage(msg)
    const assistantEl = appendAssistantMessage()
    setLoading(true)

    // Simpan ke history sebelum kirim
    history.push({ role: 'user', content: msg })

    try {
      const res = await fetch(`${WORKER_URL}/api/chat`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message: msg,
          history: history.slice(-6),
        }),
      })

      if (!res.ok) throw new Error(`HTTP ${res.status}`)

      const data = await res.json() as { answer: string; sources: string[]; hasContext: boolean }

      fillAssistantMessage(assistantEl, data.answer, data.sources, data.hasContext)
      history.push({ role: 'assistant', content: data.answer })

    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : 'Unknown error'
      fillAssistantMessage(
        assistantEl,
        `Gagal terhubung ke server: ${message}`,
        [],
        false
      )
    } finally {
      setLoading(false)
      inputEl.focus()
    }
  }
</script>

<style>
  @reference "@/styles/global.css";

  .dot {
    animation: blink 1.2s infinite;
    display: inline-block;
  }
  .dot:nth-child(2) { animation-delay: 0.2s; }
  .dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes blink {
    0%, 80%, 100% { opacity: 0.2; }
    40% { opacity: 1; }
  }

  #messages {
    scrollbar-width: thin;
  }
</style>
