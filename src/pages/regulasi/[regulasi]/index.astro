---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'

export async function getStaticPaths() {
        const entries = await getCollection('regulasi', ({ data }) => !data.draft)

        // Ambil unique regulasi slug
        const regulasiSlugs = [...new Set(entries.map((e) => e.id.split('/')[0]))]

        return regulasiSlugs.map((regulasi) => ({
                params: { regulasi },
                props: {
                        entries: entries
                                .filter((e) => e.id.startsWith(regulasi + '/'))
                                .sort((a, b) => a.data.pasal - b.data.pasal),
                },
        }))
}

const { entries } = Astro.props
const { regulasi } = Astro.params
const firstEntry = entries[0]
---

<Layout
        variant="base"
        meta={{
                title: regulasi.toUpperCase(),
                description: `Daftar pasal ${regulasi}`,
        }}
>
        <header class="mb-8">
                <p class="text-P-subtle text-sm uppercase tracking-wide mb-2">{firstEntry?.data.kategori}</p>
                <h1 class="text-h1 text-P-heading">{regulasi.toUpperCase()}</h1>
        </header>

        <ul class="flex flex-col gap-3">
                {entries.map((entry) => {
                        const [regulasiSlug, pasalSlug] = entry.id.split('/')
                        return (
                                <li class="flex items-baseline gap-3">
                                        <span class="text-P-subtle text-sm w-16 shrink-0">Pasal {entry.data.pasal}</span>
                                        <a href={`/regulasi/${regulasiSlug}/${pasalSlug}`} class="text-P-link hover:underline">
                                                {entry.data.judul}
                                        </a>
                                        {entry.data.status !== 'berlaku' && (
                                                <span class="text-P-subtle text-xs">[{entry.data.status}]</span>
                                        )}
                                </li>
                        )
                })}
        </ul>
</Layout>