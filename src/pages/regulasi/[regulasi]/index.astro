---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'

export async function getStaticPaths() {
        const entries = await getCollection('regulasi', ({ data }) => !data.draft)

        // Ambil unique regulasi slug
        const regulasiSlugs = [...new Set(entries.map((e) => e.id.split('/')[0]))]

        return regulasiSlugs.map((regulasi) => ({
                params: { regulasi },
                props: {
                        entries: entries
                                .filter((e) => e.id.startsWith(regulasi + '/'))
                                .sort((a, b) => a.data.pasal - b.data.pasal),
                },
        }))
}

const { entries } = Astro.props
const { regulasi } = Astro.params
const firstEntry = entries[0]
---

<Layout
        variant="page"
        meta={{
                title: regulasi.toUpperCase(),
                description: `Daftar pasal ${regulasi}`,
        }}
>
        <header class="mb-8">
                <p class="text-P-subtle text-sm uppercase tracking-wide mb-2">{firstEntry?.data.kategori}</p>
                <h1 class="text-h1 text-P-heading">{regulasi.toUpperCase()}</h1>
        </header>

        <ul class="space-y-6">
        {entries.map((entry) => {
                const [regulasiSlug, pasalSlug] = entry.id.split('/')
                return (
                        <li>
                                <a href={`/regulasi/${regulasiSlug}/${pasalSlug}/`} class="group block">
                                        <h2 class="text-xl font-semibold transition-[color,text-decoration-thickness] underline underline-offset-2 decoration-current decoration-1 hover:decoration-[1.5px] text-P-link group-hover:text-P-link-hover">
                                                Pasal {entry.data.pasal} — {entry.data.judul}
                                        </h2>
                                        {entry.data.status !== 'berlaku' && (
                                                <span class="text-sm text-P-subtle">[{entry.data.status}]</span>
                                        )}
                                </a>
                        </li>
                )
        })}
</ul>
</Layout>