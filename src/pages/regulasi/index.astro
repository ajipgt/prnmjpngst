---
import { getCollection } from 'astro:content'
import Layout from '@/layouts/Layout.astro'

const entries = await getCollection('regulasi', ({ data }) => !data.draft)

// Kelompokkan per kategori
const grouped = entries.reduce(
        (acc, entry) => {
                const key = entry.data.kategori
                if (!acc[key]) acc[key] = []
                acc[key].push(entry)
                return acc
        },
        {} as Record<string, typeof entries>,
)

const labelKategori: Record<string, string> = {
        'undang-undang': 'Undang-Undang',
        'peraturan-pemerintah': 'Peraturan Pemerintah',
        'peraturan-menteri': 'Peraturan Menteri',
        'keputusan-dirjen': 'Keputusan Dirjen',
}
---

<Layout variant="page" meta={{ title: 'Regulasi', description: 'Referensi regulasi pengujian berkala kendaraan bermotor' }}>
        <h1 class="text-h1 text-P-heading mb-8">Regulasi</h1>

        {Object.entries(grouped).map(([kategori, items]) => (
                <section class="mb-10">
                        <h2 class="text-h2 text-P-heading mb-4">{labelKategori[kategori] ?? kategori}</h2>
                        <ul class="flex flex-col gap-2">
                                {items.map((entry) => {
                                        const [regulasiSlug, pasalSlug] = entry.id.split('/')
                                        return (
                                                <li>
                                                        <a href={`/regulasi/${regulasiSlug}/${pasalSlug}`} class="text-P-link hover:underline">
                                                                Pasal {entry.data.pasal} — {entry.data.judul}
                                                        </a>
                                                        <span class="text-P-subtle text-sm ml-2">{entry.data.status}</span>
                                                </li>
                                        )
                                })}
                        </ul>
                </section>
        ))}
</Layout>